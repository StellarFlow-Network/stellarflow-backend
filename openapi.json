    "/proof/pool-status": {
      "get": {
        "description": "Return process pool status for observability.",
        "operationId": "pool_status_proof_pool_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Pool Status"
      }
