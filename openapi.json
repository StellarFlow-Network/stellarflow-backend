    "/proof/verify": {
      "post": {
        "description": "Verify a single shielded transaction proof.\n\nOffloads CPU-intensive ZK proof checks to a background worker process pool.\nReturns cached results within the 100ms latency budget when available.",
        "operationId": "verify_proof_proof_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProofVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofVerificationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Proof"
      }
    },
    "/proof/verify-batch": {
      "post": {
        "description": "Verify multiple shielded transaction proofs concurrently.",
        "operationId": "verify_proof_batch_endpoint_proof_verify_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ProofVerificationRequest"
                },
                "title": "Requests",
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
