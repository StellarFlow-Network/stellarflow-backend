                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Proof Batch Endpoint"
      }
    },
    "/webhook/webhook/anchor": {
      "post": {
        "description": "Handle incoming webhook status updates from financial anchor partners\nregarding fiat payout completion status.",
        "operationId": "receive_anchor_webhook_webhook_webhook_anchor_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Anchor-Signature",
            "required": false,
            "schema": {
              "title": "X-Anchor-Signature",
              "type": "string"
