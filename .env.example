# [OPS] Required Environment Variables
DB_URL=postgresql://username:password@localhost:5432/stellarflow
STELLAR_KEY=your_stellar_key_here

# Signer Configuration (Issue #223)
# Valid backends: "kms" (production), "local" (dev/test)
SIGNER_BACKEND=local
# Required for backend=local
STELLAR_SECRET=your_stellar_secret_here
# Required for backend=kms
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/uuid
AWS_REGION=us-east-1
# Public key must be stored locally when using KMS (cannot be derived from HSM without a round-trip)
STELLAR_PUBLIC_KEY=GB...

# Server Configuration
PORT=3000
API_KEY=the_secret_api_key_here
REDIS_URL=redis://localhost:6379

# Prometheus metrics endpoint — must be set or /metrics returns 403
METRICS_SECRET=change-me-to-a-long-random-string

# Regional failover configuration
PRIMARY_CLUSTER_HEALTH_URL=https://lagos-backend.example.com
SECONDARY_CLUSTER_HEALTH_URL=https://frankfurt-backend.example.com
REGIONAL_HEARTBEAT_PATH=/health
REGIONAL_HEARTBEAT_INTERVAL_MS=30000
REGIONAL_HEARTBEAT_TIMEOUT_MS=5000
FAILOVER_THRESHOLD=3

# API Keys (optional - some rate sources may require)
OPENEXCHANGE_RATES_API_KEY=your_api_key_here

# VTpass (optional — enables NGN/XLM via local VTpass variation pricing)
# See: https://www.vtpass.com/documentation/variation-codes/
# Set VTPASS_NGN_SERVICE_ID + VTPASS_NGN_VARIATION_CODE to a variation whose
# variation_amount (or variation_rate) represents NGN charged per 1 USD of value.
VTPASS_API_BASE_URL=https://vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_NGN_SERVICE_ID=
VTPASS_NGN_VARIATION_CODE=

# API Provider Secret Rotation (optional)
# Endpoint should return secrets in one of these shapes:
# - { "secrets": { "VTPASS_API_KEY": "..." } } (e.g. Doppler)
# - { "data": { "data": { "VTPASS_API_KEY": "..." } } } (e.g. Vault KV v2)
API_PROVIDER_SECRET_MANAGER_URL=
API_PROVIDER_SECRET_MANAGER_TOKEN=
# Comma-separated keys to rotate (defaults include Binance + VTpass keys)
API_PROVIDER_SECRET_KEYS=BINANCE_API_KEY,BINANCE_SECRET_KEY,VTPASS_API_KEY,VTPASS_PUBLIC_KEY

# Dashboard URL (legacy single-origin CORS allowlist; prefer CORS_ALLOWED_ORIGINS)
DASHBOARD_URL=http://localhost:3000

# CORS & Security Headers (Issue #792)
# Comma-separated allowlist of approved web and mobile client origins.
# Supports single-label wildcards, e.g. https://*.dashboard.stellarflow.io matches
# https://staging.dashboard.stellarflow.io but not https://a.b.dashboard.stellarflow.io.
# Mobile webview origins such as capacitor://localhost may be listed here.
# "*" is rejected: the policy requires an explicit allowlist.
# Falls back to DASHBOARD_URL/FRONTEND_URL when unset. In production an empty
# allowlist aborts startup rather than silently denying every client.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Send Access-Control-Allow-Credentials (default true)
CORS_ALLOW_CREDENTIALS=true
# Preflight cache lifetime in seconds (default 600)
CORS_MAX_AGE_SECONDS=600
# Override the preflight-advertised methods/headers if a client needs more
# CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-API-Key
# CORS_EXPOSED_HEADERS=RateLimit-Limit,RateLimit-Remaining

# Origin guard: "enforce" (default) rejects /api requests whose Origin is not
# allowlisted, and requests with no Origin that do not present an X-API-Key or
# X-Stellar-Signature header. Use "report-only" to log violations without
# blocking while rolling the policy out.
CORS_ORIGIN_ENFORCEMENT=enforce

# Content-Security-Policy rollout controls
# Send Content-Security-Policy-Report-Only instead of enforcing the policy
CSP_REPORT_ONLY=false
# Optional endpoint that collects CSP violation reports
CSP_REPORT_URI=

# HTTP Strict-Transport-Security (default: 1 year, no subdomains, no preload)
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# Stellar Configuration (for future integration)
SOROBAN_ADMIN_SECRET=your_admin_secret_here
STELLAR_SECRET=your_stellar_secret_here
STELLAR_NETWORK=TESTNET

# Soroban Contract Configuration
# Target smart contract ID for state sanity checks on startup
CONTRACT_ID=your_contract_id_here

# Invariant Violation Automated Circuit Breaker (Issue #829)
# Set to "true" to enable the automated circuit breaker. When enabled, the
# off-chain invariant checker monitors balance invariants and, on a CRITICAL
# breach, auto-submits a pause() transaction to CONTRACT_ID signed with the
# emergency keeper key, then notifies the security team via the webhook channels.
CIRCUIT_BREAKER_ENABLED=false
# Minimum XLM the keeper account must hold (balance invariant floor)
INVARIANT_MIN_KEEPER_XLM_BALANCE=20
# How often the invariant checker polls on-chain state (ms)
CIRCUIT_BREAKER_CHECK_INTERVAL_MS=60000
# Minimum gap between automated pause() submissions for the same breach (ms)
CIRCUIT_BREAKER_COOLDOWN_MS=1800000

# Gas Account Monitoring
# Preferred: set public key directly, or set GAS_ACCOUNT_SECRET/STELLAR_SECRET to derive it
GAS_ACCOUNT_PUBLIC_KEY=
GAS_ACCOUNT_SECRET=
# Alert threshold in XLM
GAS_ALERT_THRESHOLD_XLM=10

# Gas & CPU Instruction Profiler (Issue #786)
# Set to "false" to disable sampling, backfill, and the daily rollup job
GAS_PROFILER_ENABLED=true
# How often the RPC backfill poller runs (milliseconds). Default: 5 minutes
GAS_PROFILER_BACKFILL_INTERVAL_MS=300000
# Optional function-name aliases for classification, e.g. settle:swap,top_up:deposit
GAS_PROFILER_TX_TYPE_ALIASES=
# Spike alert: percent increase over the trailing baseline mean (default 50)
GAS_SPIKE_PERCENT_THRESHOLD=50
# Spike alert: z-score above the baseline mean (default 3)
GAS_SPIKE_Z_SCORE_THRESHOLD=3
# Minimum baseline daily samples before a spike can fire (default 5)
GAS_SPIKE_MIN_BASELINE_SAMPLES=5
# Number of preceding days used as the spike baseline window (default 7)
GAS_SPIKE_BASELINE_DAYS=7
# Backfill requires CONTRACT_ID (above) so only protocol contract calls are stored.
# Apply schema with: npx prisma db push  (migrations/ is gitignored in this repo)

# Database Configuration (for future integration)
DATABASE_URL=postgresql://username:password@localhost:6432/stellarflow?schema=public&sslmode=require
DIRECT_DATABASE_URL=postgresql://username:password@localhost:5432/stellarflow?schema=public&sslmode=require
PGBOUNCER_ENABLED=true
PG_POOL_MAX=20
PG_POOL_MIN=0
PG_POOL_IDLE_TIMEOUT_MS=10000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Daily PostgreSQL backup (scripts/pg_backup.sh). Leave BACKUP_S3_URI empty for local-only backups.
BACKUP_DIR=backups/postgres
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
BACKUP_S3_KMS_KEY_ID=
BACKUP_S3_RETENTION_DAYS=30
BACKUP_S3_OBJECT_LOCK_MODE=COMPLIANCE

# Automated cross-border liquidity rebalancing (optional)
# Each asset rate is expressed as fiat units per XLM. XLM itself always has a rate of 1.
# Supported fiat rate providers: GHS, KES, NGN.
ANCHOR_LIQUIDITY_POOLS=[{"key":"ngn-ghs","anchorAccount":"G...","assets":[{"code":"NGN","issuer":"G..."},{"code":"GHS","issuer":"G..."}],"managerAccounts":["liquidity@example.com"]}]
LIQUIDITY_MANAGER_ALERT_WEBHOOK_URL=https://example.com/liquidity-alerts
# Rate Limiting
ADMIN_IP=127.0.0.1
ADMIN_API_KEY=
# Set to "true" if the app is behind a reverse proxy (nginx, AWS ALB, etc.)
# so X-Forwarded-For is trusted for real client IP resolution
TRUST_PROXY=false

# Relayer Signature Verification (Issue #225)
# Set to "true" to enforce Ed25519 X-Stellar-Signature header on all relayer requests
# When "false" (default), violations are logged but requests are allowed through
RELAYER_SIGNATURE_REQUIRED=false

# Webhook Error Reporting
# Discord webhook URL for critical alerts (primary)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Slack webhook URL for critical alerts (fallback)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Rate limit for webhook alerts (minutes)
WEBHOOK_RATE_LIMIT_MINUTES=5

# Cross-border compliance screening (Issue #784)
# POST body: { "address": "<stellar public key>", "network": "stellar" }
# Expected JSON: { "sanctioned": true|false }
COMPLIANCE_SCREENING_API_URL=
COMPLIANCE_SCREENING_API_KEY=
COMPLIANCE_SCREENING_INTERVAL_MS=15000
COMPLIANCE_SCREENING_BATCH_SIZE=25
# Optional receiving-anchor payout URL. Relay is skipped (local success) when unset,
# and always blocked when a remittance is flagged_compliance.
ANCHOR_PAYOUT_RELAY_URL=

# Probe timeout for /health/readiness (Issue #782)
HEALTH_PROBE_TIMEOUT_MS=3000

# Tracing Configuration
# Enable/disable distributed tracing
TRACING_ENABLED=false
# Service name for trace identification
TRACING_SERVICE_NAME=stellarflow-backend
# Enable console exporter for development
TRACING_CONSOLE_EXPORTER=true
# Jaeger collector endpoint
TRACING_JAEGER_ENDPOINT=http://localhost:14268/api/traces
# Honeycomb configuration
TRACING_HONEYCOMB_ENDPOINT=https://api.honeycomb.io/v1/events
TRACING_HONEYCOMB_API_KEY=your_honeycomb_api_key_here
TRACING_HONEYCOMB_DATASET=stellarflow
# Export interval in milliseconds
TRACING_EXPORT_INTERVAL_MS=5000
# Sampling rate (0.0-1.0)
TRACING_SAMPLING_RATE=1.0

# User Access Logging (Issue #227 - SOC2 Compliance)
# JWT secret for dashboard authentication (min 32 chars)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
# JWT expiry time in hours
JWT_EXPIRY_HOURS=24
# Session secret for session management
SESSION_SECRET=change-this-to-a-secure-random-string-min-32

# Flash Loan Revenue Accounting & Protocol Yield Analytics
FLASH_LOAN_CONTRACT_ID=your_flash_loan_contract_id_here
YIELD_ANALYTICS_INTERVAL_MS=300000
# Anchor settlement polling (SEP-24 / SEP-31)
ANCHOR_SEP24_STATUS_URL=
ANCHOR_SEP31_STATUS_URL=

# PDF Payment Receipt Generator (Issue #772)
# S3 bucket used to store generated receipt PDFs. Falls back to S3_BUCKET.
RECEIPT_STORAGE_BUCKET=
# S3 key prefix for stored receipts
RECEIPT_STORAGE_PREFIX=receipts
# Signed download URL validity in seconds (1 - 604800)
RECEIPT_DOWNLOAD_URL_TTL_SECONDS=86400
# Comma-separated channels used to deliver the signed receipt link:
# "webhook,email" (email is only delivered when SMTP is configured)
RECEIPT_NOTIFICATION_CHANNELS=webhook,email
# Optional sender displayed on receipt emails / notifications
RECEIPT_EMAIL_FROM=StellarFlow <receipts@stellarflow.example>

# SMTP configuration for email receipt delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
